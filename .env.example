# คัดลอกเป็น .env แล้ว chmod 600 (ห้าม commit ไฟล์ .env)
OPD_DB_MODE=direct
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hos
DB_USER=<readonly_user>
DB_PASS=<password>
PORT=5900

# ---- ค่าเสริม (ไม่ใส่ก็ได้) — ความหมายดู INSTALL.md หัวข้อ 4
# OPD_CONTACT=งานสารสนเทศ โทร 1234
# OPD_HOSPITAL_NAME=โรงพยาบาล...
# ค่าที่ควรใส่ของ OPD_ST_MAP ดูได้ที่หน้า /check
# OPD_ST_MAP=screen:service1,screen_end:service2
# OPD_DEP_MAP=011=ER,040=TELE
# OPD_FLOW_LAYOUT=/opt/opd_dashboard/flow_layout.json
# OPD_MAX_DAYS=366
# OPD_DB_TIMEOUT=60
# รหัสมาตามนัด (ovst.ovstist) ถ้าไม่ใช่ 02 — ดูหน้า /check
# OPD_APPT_CODES=02
# ตรวจข้อมูลกับรายงานเดิมแล้ว (ซ่อนแถบเตือนบนแดชบอร์ด) — ตั้งหลังทำ INSTALL.md ข้อ 0 ครบ
# OPD_DATA_AUDITED=1
